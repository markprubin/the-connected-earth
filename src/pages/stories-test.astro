---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const stories = [
  { title: "The Last Fishermen of the Aral Sea", category: "Photojournalism", date: "March 2026", img: "https://picsum.photos/seed/aral/1200/800" },
  { title: "Burning Season", category: "Photojournalism", date: "February 2026", img: "https://picsum.photos/seed/burn/1200/800" },
  { title: "Where the Ice Remembers", category: "Blog", date: "February 2026", img: "https://picsum.photos/seed/ice/1200/800" },
  { title: "Voices from the Flood Plain", category: "Photojournalism", date: "January 2026", img: "https://picsum.photos/seed/flood/1200/800" },
  { title: "The Quiet After the Storm", category: "Blog", date: "January 2026", img: "https://picsum.photos/seed/storm/1200/800" },
  { title: "Children of the Dust", category: "Photojournalism", date: "December 2025", img: "https://picsum.photos/seed/dust/1200/800" },
  { title: "Crossing the Cerrado", category: "Photojournalism", date: "November 2025", img: "https://picsum.photos/seed/cerrado/1200/800" },
  { title: "A River With No Name", category: "Blog", date: "October 2025", img: "https://picsum.photos/seed/river/1200/800" },
  { title: "When the Monsoon Fails", category: "Photojournalism", date: "September 2025", img: "https://picsum.photos/seed/monsoon/1200/800" },
];
---
<BaseLayout title="Stories — Test">
  <div class="page">
    <Header dark={true} />
    <main>
      <div class="grid">
        {stories.map(story => (
          <article class="card">
            <div class="card-image">
              <img src={story.img} alt={story.title} />
              <div class="card-overlay">
                <h2 class="card-title">{story.title}</h2>
                <div class="card-meta">
                  <span class="category">{story.category}</span>
                  <span class="date">{story.date}</span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    background: #0e0e0e;
    color: #e8e4dc;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 48px 120px;
  }

  .grid {
    display: flex;
    flex-direction: column;
    gap: 120px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    cursor: pointer;
  }

  .card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease, filter 0.6s ease;
    filter: brightness(0.88);
  }

  .card:hover .card-image img {
    transform: scale(1.02);
    filter: brightness(1);
  }

  .card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 48px 36px 28px;
    background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, transparent 100%);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card-meta {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .category {
    font-family: 'Formera', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232, 228, 220, 0.65);
  }

  .date {
    font-family: 'Formera', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(232, 228, 220, 0.45);
  }

  .card-title {
    font-family: 'Darker Grotesque', sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.2;
    color: #e8e4dc;
    max-width: 720px;
  }
</style>
