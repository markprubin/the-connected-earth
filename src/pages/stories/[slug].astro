---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { sanityClient } from '../../lib/sanity';
import { PortableText } from '@portabletext/react';

export async function getStaticPaths() {
  const stories = await sanityClient.fetch(`
    *[_type == "story"] {
      slug
    }
  `);

  return stories.map((story: any) => ({
    params: { slug: story.slug.current },
  }));
}

const { slug } = Astro.params;

const story = await sanityClient.fetch(`
  *[_type == "story" && slug.current == $slug][0] {
    title,
    description,
    publishedAt,
    category,
    coverPhoto {
      asset -> { url },
      caption
    },
    body
  }
`, { slug });
---
<BaseLayout
  title={story.title}
  description={story.description}
  image={story.coverPhoto?.asset?.url}
>
  <div class="page">
    <Header dark={true} />
    <article>
      {story.coverPhoto?.asset?.url && (
        <div class="cover">
          <img src={story.coverPhoto.asset.url} alt={story.coverPhoto.caption || story.title} />
          {story.coverPhoto.caption && <p class="caption">{story.coverPhoto.caption}</p>}
        </div>
      )}
      <div class="content">
        <div class="meta">
          <span class="category">{story.category}</span>
          {story.publishedAt && (
            <span class="date">{new Date(story.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          )}
        </div>
        <h1>{story.title}</h1>
        <div class="body">
          {story.body?.map((block: any) => {
            if (block._type === 'block') {
              return <p>{block.children?.map((child: any) => child.text).join('')}</p>;
            }
            if (block._type === 'image' && block.asset?.url) {
              return (
                <figure>
                  <img src={block.asset.url} alt={block.caption || ''} />
                  {block.caption && <figcaption>{block.caption}</figcaption>}
                </figure>
              );
            }
          })}
        </div>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    background: #0e0e0e;
    color: #e8e4dc;
  }

  .cover {
    width: 100%;
    max-height: 80vh;
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.9);
  }

  .caption {
    font-family: 'Formera', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: rgba(232, 228, 220, 0.35);
    padding: 10px 48px;
  }

  .content {
    max-width: 720px;
    margin: 64px auto;
    padding: 0 48px;
  }

  .meta {
    display: flex;
    gap: 20px;
    margin-bottom: 24px;
  }

  .category {
    font-family: 'Formera', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232, 228, 220, 0.45);
  }

  .date {
    font-family: 'Formera', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(232, 228, 220, 0.25);
  }

  h1 {
    font-family: 'Beth Ellen', cursive;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.2;
    color: #e8e4dc;
    margin-bottom: 48px;
  }

  .body p {
    font-family: 'Formera', sans-serif;
    font-size: 1.05rem;
    line-height: 1.85;
    color: rgba(232, 228, 220, 0.75);
    margin-bottom: 28px;
  }

  .body figure {
    margin: 48px 0;
  }

  .body figure img {
    width: 100%;
    display: block;
  }

  .body figcaption {
    font-family: 'Formera', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: rgba(232, 228, 220, 0.35);
    margin-top: 10px;
  }
</style>
