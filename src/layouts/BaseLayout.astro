---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — The Connected Earth</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Beth+Ellen&family=Chakra+Petch:wght@300;400;500&family=Darker+Grotesque:wght@300;400;500;600;700;900&display=swap" rel="stylesheet" />
  <style>
    @font-face {
      font-family: 'Formera';
      src: url('/fonts/Formera-Regular.otf') format('opentype');
      font-weight: 400;
    }

    @font-face {
      font-family: 'Formera';
      src: url('/fonts/Formera-Light.otf') format('opentype');
      font-weight: 300;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      width: 100%;
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
