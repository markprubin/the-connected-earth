---
const {
  title,
  description = 'The Connected Earth — photojournalism and stories about our changing planet.',
  image = '/images/Logo_Circle.png',
  canonicalURL = Astro.url.href,
} = Astro.props;

const fullTitle = title === 'The Connected Earth' ? title : `${title} — The Connected Earth`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph (social sharing) -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="The Connected Earth" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Beth+Ellen&family=Chakra+Petch:wght@300;400;500&family=Darker+Grotesque:wght@300;400;500;600;700;900&display=swap" rel="stylesheet" />

  <style>
    @font-face {
      font-family: 'Formera';
      src: url('/fonts/Formera-Regular.otf') format('opentype');
      font-weight: 400;
    }

    @font-face {
      font-family: 'Formera';
      src: url('/fonts/Formera-Light.otf') format('opentype');
      font-weight: 300;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      width: 100%;
    }
  </style>
</head>
<body>
  <slot />

  <div class="coming-soon-overlay" id="comingSoonOverlay">
    <div class="coming-soon-modal">
      <p class="coming-soon-label">Notice</p>
      <h2 class="coming-soon-title">We're not ready yet.</h2>
      <p class="coming-soon-body">Something is being built here. Check back soon — the earth has stories to tell.</p>
      <button class="coming-soon-close" onclick="document.getElementById('comingSoonOverlay').style.display='none'">Dismiss</button>
    </div>
  </div>

  <style>
    .coming-soon-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(4px);
    }

    .coming-soon-modal {
      background: #111111;
      border: 1px solid rgba(255, 255, 255, 0.07);
      max-width: 480px;
      width: 90%;
      padding: 52px 48px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .coming-soon-label {
      font-family: 'Formera', sans-serif;
      font-size: 0.65rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: rgba(232, 228, 220, 0.35);
    }

    .coming-soon-title {
      font-family: 'Beth Ellen', cursive;
      font-size: 2rem;
      font-weight: 400;
      color: #e8e4dc;
      line-height: 1.2;
    }

    .coming-soon-body {
      font-family: 'Formera', sans-serif;
      font-size: 0.95rem;
      line-height: 1.75;
      color: rgba(232, 228, 220, 0.55);
    }

    .coming-soon-close {
      align-self: flex-start;
      margin-top: 8px;
      font-family: 'Formera', sans-serif;
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(232, 228, 220, 0.5);
      background: none;
      border: 1px solid rgba(232, 228, 220, 0.15);
      padding: 10px 20px;
      cursor: pointer;
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .coming-soon-close:hover {
      color: #e8e4dc;
      border-color: rgba(232, 228, 220, 0.4);
    }
  </style>

  <script>
    setTimeout(() => {
      const overlay = document.getElementById('comingSoonOverlay');
      if (overlay) {
        overlay.style.display = 'flex';
      }
    }, 1000);
  </script>
</body>
</html>
