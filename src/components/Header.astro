---
---
<header>
  <a class="home" href="/">
    <img src="/images/Logo_Circle.png" alt="The Connected Earth logo" />
    <span class="site-name">the connected earth</span>
  </a>
  <nav>
    <a href="/about">About</a>
    <a href="/stories">Stories</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  header a.home {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  header img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .site-name {
    font-family: 'Beth Ellen', cursive;
    font-size: 1.1rem;
    color: #2a2a2a;
  }

  nav {
    display: flex;
    gap: 36px;
  }

  nav a {
    font-family: 'Formera', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #2a2a2a;
    text-decoration: none;
    opacity: 0.7;
    padding: 4px 8px;
    border-radius: 4px;
    transition: opacity 0.2s ease, background 0.2s ease;
  }

  nav a:hover {
    opacity: 1;
    background: rgba(0, 0, 0, 0.05);
  }
</style>
