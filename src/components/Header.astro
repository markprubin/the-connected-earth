---
const { dark = false } = Astro.props;
---
<header class={dark ? 'dark' : ''}>
  <a class="home" href="/">
    <img src="/images/Logo_Circle.png" alt="The Connected Earth logo" />
    <span class="site-name">the connected earth</span>
  </a>
  <nav class="desktop-nav">
    <a href="/about">About</a>
    <a href="/stories">Stories</a>
  </nav>
  <button class="menu-btn" id="menuBtn" aria-label="Open menu">
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<div class="nav-drawer" id="navDrawer">
  <button class="close-btn" id="closeBtn" aria-label="Close menu">✕</button>
  <nav>
    <a href="/about">About</a>
    <a href="/stories">Stories</a>
  </nav>
</div>

<div class="overlay" id="overlay"></div>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    position: relative;
    z-index: 100;
  }

  header.dark {
    border-bottom-color: rgba(255,255,255,0.06);
  }

  header a.home {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  header img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .site-name {
    font-family: 'Beth Ellen', cursive;
    font-size: 1.1rem;
    color: #2a2a2a;
  }

  header.dark .site-name {
    color: rgba(232, 228, 220, 0.85);
  }

  /* Hamburger button */
  .menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .menu-btn span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: #2a2a2a;
    transition: background 0.2s ease;
  }

  header.dark .menu-btn span {
    background: rgba(232, 228, 220, 0.85);
  }

  /* Drawer */
  .nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 280px;
    height: 100vh;
    background: #111111;
    z-index: 200;
    display: flex;
    flex-direction: column;
    padding: 48px 40px;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .nav-drawer.open {
    transform: translateX(0);
  }

  .close-btn {
    align-self: flex-end;
    background: none;
    border: none;
    color: rgba(232, 228, 220, 0.5);
    font-size: 1rem;
    cursor: pointer;
    margin-bottom: 48px;
    transition: color 0.2s ease;
  }

  .close-btn:hover {
    color: #e8e4dc;
  }

  .nav-drawer nav {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .nav-drawer nav a {
    font-family: 'Formera', sans-serif;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(232, 228, 220, 0.7);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-drawer nav a:hover {
    color: #e8e4dc;
  }

  /* Overlay */
  .overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 150;
    backdrop-filter: blur(2px);
  }

  .overlay.open {
    display: block;
  }

  /* Desktop nav */
  .desktop-nav {
    display: flex;
    gap: 36px;
  }

  .desktop-nav a {
    font-family: 'Formera', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #2a2a2a;
    text-decoration: none;
    opacity: 0.7;
    padding: 4px 8px;
    border-radius: 4px;
    transition: opacity 0.2s ease, background 0.2s ease;
  }

  header.dark .desktop-nav a {
    color: rgba(232, 228, 220, 0.85);
  }

  .desktop-nav a:hover {
    opacity: 1;
    background: rgba(0, 0, 0, 0.05);
  }

  header.dark .desktop-nav a:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  @media (max-width: 600px) {
    .desktop-nav {
      display: none;
    }
  }

  @media (max-width: 600px) {
    header {
      padding: 20px 24px;
    }

    .menu-btn {
      display: flex;
    }
  }

  @media (min-width: 601px) {
    .menu-btn {
      display: none;
    }

    /* Show inline nav on desktop */
    header::after {
      content: none;
    }
  }
</style>

<script>
  const menuBtn = document.getElementById('menuBtn');
  const closeBtn = document.getElementById('closeBtn');
  const drawer = document.getElementById('navDrawer');
  const overlay = document.getElementById('overlay');

  menuBtn?.addEventListener('click', () => {
    drawer?.classList.add('open');
    overlay?.classList.add('open');
  });

  closeBtn?.addEventListener('click', () => {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
  });

  overlay?.addEventListener('click', () => {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
  });
</script>
